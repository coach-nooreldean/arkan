{
  "phrases": [
    {"id": "t_1", "text": "سُبْحَانَ اللَّهِ", "target": 33, "reward": "تغرس لك نخلة في الجنة"},
    {"id": "t_2", "text": "الْحَمْدُ لِلَّهِ", "target": 33, "reward": "تملأ الميزان بالخير"},
    {"id": "t_3", "text": "لَا إِلَهَ إِلَّا اللَّهُ", "target": 33, "reward": "أفضل ما قاله النبيون"},
    {"id": "t_4", "text": "اللَّهُ أَكْبَرُ", "target": 33, "reward": "أحب الكلام إلى الله"},
    {"id": "t_5", "text": "أَسْتَغْفِرُ اللَّهَ وَأَتُوبُ إِلَيْهِ", "target": 100, "reward": "ممحاة للذنوب ومجلبة للرزق والبركة"},
    {"id": "t_6", "text": "لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ", "target": 33, "reward": "كنز من كنوز الجنة ودواء من تسعة وتسعين داء"},
    {"id": "t_7", "text": "اللَّهُمَّ صَلِّ وَسَلِّمْ عَلَى نَبِيِّنَا مُحَمَّدٍ", "target": 100, "reward": "تُكفى همك ويُغفر ذنبك"},
    {"id": "t_8", "text": "سُبْحَانَ اللَّهِ وَبِحَمْدِهِ ، سُبْحَانَ اللَّهِ الْعَظِيمِ", "target": 33, "reward": "كلمتان خفيفتان على اللسان ثقيلتان في الميزان"},
    {"id": "t_9", "text": "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ", "target": 33, "reward": "أمان الخائفين وتفريج الكربات"}
  ]
